{
  // =========================================================================
  // OpenClaw Multi-Agent Configuration — Template (safe for public repo)
  // =========================================================================
  // This file is safe to commit to a public repo — no API keys, no tokens.
  //
  // To generate a working config with your local secrets:
  //   ./openclaw/generate-config.sh > ~/.openclaw/openclaw.json
  //
  // Or do a full setup:
  //   ./openclaw/setup.sh --apply
  // =========================================================================

  "agents": {
    "defaults": {
      "workspace": "{{HOME}}/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      }
    },

    // ---- Specialist Agents ----
    "list": [
      {
        "id": "orchestrator",
        "name": "Nexus Orchestrator",
        "workspace": "{{HOME}}/.openclaw/workspaces/orchestrator",
        "agentDir": "{{HOME}}/.openclaw/agents/orchestrator/agent",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      },
      {
        "id": "coding",
        "name": "Coder",
        "workspace": "{{HOME}}/.openclaw/workspaces/coding",
        "agentDir": "{{HOME}}/.openclaw/agents/coding/agent",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      },
      {
        "id": "research",
        "name": "Scholar",
        "workspace": "{{HOME}}/.openclaw/workspaces/research",
        "agentDir": "{{HOME}}/.openclaw/agents/research/agent",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      },
      {
        "id": "cs285",
        "name": "DeepRL Professor",
        "workspace": "{{HOME}}/.openclaw/workspaces/cs285",
        "agentDir": "{{HOME}}/.openclaw/agents/cs285/agent",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      },
      {
        "id": "general",
        "name": "Atlas",
        "workspace": "{{HOME}}/.openclaw/workspaces/general",
        "agentDir": "{{HOME}}/.openclaw/agents/general/agent",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        }
      }
    ]
  },

  // ---- Gateway ----
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "{{GATEWAY_TOKEN}}"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },

  // ---- Model Providers (no API keys — those go in per-agent models.json) ----
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0.14,
              "output": 0.28,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 1.74,
              "output": 3.48,
              "cacheRead": 0.145,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0.28,
              "output": 0.42,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 131072,
            "maxTokens": 8192,
            "compat": {
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-reasoner",
            "name": "DeepSeek Reasoner",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0.28,
              "output": 0.42,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 131072,
            "maxTokens": 65536,
            "compat": {
              "supportsReasoningEffort": false,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          }
        ]
      }
    }
  },

  // ---- Auth Profiles (no keys — extracted from existing config or prompted) ----
  "auth": {
    "profiles": {
      "deepseek:default": {
        "provider": "deepseek",
        "mode": "api_key"
      }
    }
  },

  // ---- Plugins ----
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      },
      "openclaw-weixin": {
        "enabled": false
      },
      "duckduckgo": {
        "enabled": true
      }
    }
  },

  // ---- Routing: All WeChat → Orchestrator ----
  "bindings": [
    {
      "agentId": "orchestrator",
      "match": {
        "channel": "openclaw-weixin",
        "accountId": "*"
      }
    }
  ],

  // ---- Tool Settings ----
  "tools": {
    "profile": "coding",
    "web": {
      "search": {
        "provider": "duckduckgo",
        "enabled": true
      }
    },
    // Enable cross-agent messaging
    "agentToAgent": {
      "enabled": true
    }
  },

  // ---- Session Isolation ----
  "session": {
    "dmScope": "per-account-channel-peer"
  }
}
